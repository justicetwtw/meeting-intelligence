{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Intelligence",
  "version": "0.1.0",
  "identifier": "org.meeting-intelligence.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meeting Intelligence",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "publisher": "Meeting Intelligence Contributors",
    "shortDescription": "Open-source meeting intelligence for desktop and self-hosted workflows",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
